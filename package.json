{
  "name": "corvux-me",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "debug:serve": "npx serve dist",
    "heroku-postbuild": "npm run build",
    "debug:local": "npx tsc && npm run build && npx serve dist",
    "watch:site": "node scripts/build.mjs --watch",
    "watch:ts": "npx tsc --watch --preserveWatchOutput",
    "start": "http-server dist -p $PORT"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "bootstrap": "^5.3.8",
    "eslint": "^10.11.0",
    "http-server": "^14.1.1",
    "marked": "^18.0.14",
    "nunjucks": "^3.2.4",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "@types/bootstrap": "^5.2.11",
    "@types/datatables.net": "^1.12.3",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.3",
    "chokidar": "^3.6.0",
    "datatables.net-responsive": "^4.1.1",
    "mathjs": "^15.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  }
}
